Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Omega]", "*", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"corr", "[", "\"\<TrajectoryDeltas\>\"", "]"}], "[", 
           "\"\<\[CapitalDelta]t\[Theta]\>\"", "]"}], "'"}], "[", 
         RowBox[{"uz", "-", 
          RowBox[{"\[Delta]", "*", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"2", "*", "uz"}], "]"}], "/", "2"}]}]}], "]"}]}], "-", 
       RowBox[{"m", "*", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"corr", "[", "\"\<TrajectoryDeltas\>\"", "]"}], "[", 
           "\"\<\[CapitalDelta]\[Phi]\[Theta]\>\"", "]"}], "'"}], "[", 
         RowBox[{"uz", "-", 
          RowBox[{"\[Delta]", "*", 
