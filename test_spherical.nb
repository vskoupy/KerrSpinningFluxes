           "\[Delta]\[CapitalUpsilon]\[Phi]"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<BLFrequenciesCorrection\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]\[CapitalUpsilon]z", "/", "\[CapitalUpsilon]tg"}],
            "-", 
           RowBox[{"\[CapitalUpsilon]zg", "*", 
            RowBox[{"\[Delta]\[CapitalUpsilon]t", "/", 
