           RowBox[{"\[CapitalUpsilon]\[Phi]g", "*", 
            RowBox[{"\[Delta]\[CapitalUpsilon]t", "/", 
             RowBox[{"\[CapitalUpsilon]tg", "^", "2"}]}]}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<\[Delta]En\>\"", "->", 
        RowBox[{"\[Delta]constmot", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<\[Delta]Lz\>\"", "->", 
        RowBox[{"\[Delta]constmot", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<\[Delta]K\>\"", "->", 
        RowBox[{"\[Delta]constmot", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<OrbitCorrection\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "qz", "}"}], ",", 
          RowBox[{"<|", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\"\<\[Delta]\[CapitalDelta]t\>\"", "->", 
             RowBox[{"\[CapitalDelta]tspinsparsph", "[", 
              RowBox[{
              "qz", ",", "dtgd\[Lambda]coeff", ",", 
