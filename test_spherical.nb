Cell[BoxData[
 RowBox[{
  RowBox[{"KerrSpinOrbitCorrectionSphericalNew", "[", 
   RowBox[{"aint_", ",", "pint_", ",", 
    RowBox[{"eint_", "?", "PossibleZeroQ"}], ",", "xint_", ",", "kmax_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "orbitGeo", ",", "constmot", ",", "\[Delta]constmot", ",", "\[Xi]zcoeff",
       ",", "\[Delta]\[CapitalUpsilon]z", ",", "\[CapitalUpsilon]gsph", ",", 
      "\[CapitalUpsilon]rg", ",", "\[CapitalUpsilon]zg", ",", 
      "\[CapitalUpsilon]\[Phi]g", ",", "\[CapitalUpsilon]tg", ",", 
      "dtgd\[Lambda]coeff", ",", "d\[Phi]gd\[Lambda]coeff", ",", 
      "dtspind\[Lambda]sparcoeff", ",", "d\[Phi]spind\[Lambda]sparcoeff", ",",
       "\[Delta]\[CapitalUpsilon]t", ",", "\[Delta]\[CapitalUpsilon]\[Phi]"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"orbitGeo", "=", 
      RowBox[{"KerrGeoOrbit", "[", 
       RowBox[{"aint", ",", "pint", ",", "eint", ",", "xint", ",", 
        RowBox[{"\"\<Parametrization\>\"", "->", "\"\<Phases\>\""}], ",", 
        RowBox[{"\"\<Method\>\"", "->", "\"\<Analytic\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"constmot", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Egsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Jzgsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Jzgsphx0", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Kgsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}]}], "}"}]}], ";", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Calculation", " ", "constants", " ", "of", " ", 
       RowBox[{"motion", ".", " ", "Jzgsphx0"}], " ", "serves", " ", "for", 
       " ", "regularize", " ", "polar", " ", 
       RowBox[{"orbits", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]constmot", "=", 
      RowBox[{"\[Delta]constmotionsph", "[", 
       RowBox[{"aint", ",", " ", "pint", ",", " ", "xint", ",", "constmot"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Calculation", " ", "shifts", " ", "to", " ", "the", " ", "constants", 
       " ", "of", " ", "motion"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Xi]zcoeff", "=", 
      RowBox[{"\[Xi]zsparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Near", " ", "identify", " ", "shif", " ", 
       RowBox[{"functions", ".", " ", "It"}], " ", "is", " ", "need", " ", 
       "for", " ", "the", " ", "shift", " ", "to", " ", "the", " ", "theta", 
       " ", 
       RowBox[{"trajactory", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[CapitalUpsilon]z", "=", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"\[Delta]\[CapitalUpsilon]zsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint", ",", "constmot"}], "]"}], 
        "-", 
        RowBox[{"devsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint", ",", "constmot"}], "]"}]}],
        "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spin", " ", "correction", " ", "to", " ", "the", " ", "theta", " ", 
       "frequency", " ", "in", " ", "the", " ", "fixed", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "average"}], ")"}], " ", "\"\<gauge\>\""}], "*)"}],
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalUpsilon]gsph", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"orbitGeo", "[", "\"\<Frequencies\>\"", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[CapitalUpsilon]rg", ",", "\[CapitalUpsilon]zg", ",", 
        "\[CapitalUpsilon]\[Phi]g", ",", "\[CapitalUpsilon]tg"}], "}"}], "=", 
      "\[CapitalUpsilon]gsph"}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{"Geodesic", " ", "theta", " ", "frequency"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dtgd\[Lambda]coeff", "=", 
      RowBox[{"dtgd\[Lambda]coeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "geodesic", " ", 
       "coordinate", " ", "time", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"dtspind\[Lambda]sparcoeff", "=", 
      RowBox[{"dtspind\[Lambda]sparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot", ",", 
        "\[Delta]constmot", ",", "\[Xi]zcoeff"}], "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "spin", " ", 
       "correction", " ", "to", " ", "the", " ", "coordinate", " ", "time", 
       " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]gd\[Lambda]coeff", "=", 
      RowBox[{"d\[Phi]gd\[Lambda]coeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "geodesic", " ", 
       "azimuthal", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]spind\[Lambda]sparcoeff", "=", 
      RowBox[{"d\[Phi]spind\[Lambda]sparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot", ",", 
        "\[Delta]constmot", ",", "\[Xi]zcoeff"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "spin", " ", 
       "correction", " ", "to", " ", "the", " ", "azimthual", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[CapitalUpsilon]t", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"dtspind\[Lambda]sparcoeff", "[", 
        RowBox[{"[", 
         RowBox[{"kmax", "+", "1"}], "]"}], "]"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spin", " ", "correction", " ", "to", " ", "the", " ", "coordinate", 
       " ", "time", " ", "frequency", " ", "in", " ", "the", " ", "fixed", 
       " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "average"}], ")"}], " ", "\"\<gauge\>\""}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[CapitalUpsilon]\[Phi]", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"d\[Phi]spind\[Lambda]sparcoeff", "[", 
        RowBox[{"[", 
         RowBox[{"kmax", "+", "1"}], "]"}], "]"}], "]"}]}], ";", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spin", " ", "correction", " ", "to", " ", "the", " ", "azimuthal", " ",
        "frequency", " ", "in", " ", "the", " ", "fixed", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "average"}], ")"}], " ", "\"\<gauge\>\""}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "->", "aint"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<p\>\"", "->", "pint"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<e\>\"", "->", "eint"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Inclination\>\"", "->", "xint"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<En0\>\"", "->", 
        RowBox[{"constmot", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Lz0\>\"", "->", 
        RowBox[{"constmot", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<K0\>\"", "->", 
        RowBox[{"constmot", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<TrajectoryGeo\>\"", "->", 
        RowBox[{"orbitGeo", "[", "\"\<Trajectory\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<MinoFrequenciesGeo\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
         "\[CapitalUpsilon]tg", ",", "\[CapitalUpsilon]zg", ",", 
          "\[CapitalUpsilon]\[Phi]g"}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<BLFrequenciesGeo\>\"", "->", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[CapitalUpsilon]zg", ",", "\[CapitalUpsilon]\[Phi]g"}], 
          "}"}], "/", "\[CapitalUpsilon]tg"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<TrajectoryDeltas\>\"", "->", 
