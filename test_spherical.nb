Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Omega]", "*", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corr", "[", "\"\<TrajectoryDeltas\>\"", "]"}], "[", 
             "\"\<\[CapitalDelta]t\[Theta]\>\"", "]"}], "'"}], "[", 
           RowBox[{"uz", "-", 
            RowBox[{"\[Delta]", "*", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"2", "*", "uz"}], "]"}], "/", "2"}]}]}], "]"}]}], "-", 
         
         RowBox[{"m", "*", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corr", "[", "\"\<TrajectoryDeltas\>\"", "]"}], "[", 
             "\"\<\[CapitalDelta]\[Phi]\[Theta]\>\"", "]"}], "'"}], "[", 
           RowBox[{"uz", "-", 
            RowBox[{"\[Delta]", "*", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"2", "*", "uz"}], "]"}], "/", "2"}]}]}], "]"}]}], "+", 
         "k"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"\[Delta]", "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", "*", "uz"}], "]"}]}]}], ")"}]}], "/.", 
      RowBox[{"uz", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"Evaluated", "->", "True"}]}], "]"}]], "Input",
