Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Omega]", "*", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"corr", "[", "\"\<TrajectoryDeltas\>\"", "]"}], "[", 
