Cell[CellGroupData[{

Cell["Define functions", "Section",
 CellChangeTimes->{{3.975050240745133*^9, 
  3.975050246140934*^9}},ExpressionUUID->"3522417d-b345-4917-8415-\
716f49f34572"],

Cell[BoxData[
 RowBox[{
  RowBox[{"KerrSpinOrbitCorrectionSphericalHJ", "[", 
   RowBox[{"aint_", ",", "pint_", ",", 
    RowBox[{"eint_", "?", "PossibleZeroQ"}], ",", "xint_", ",", "kmax_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "orbitGeo", ",", "constmot", ",", "\[Delta]constmot", ",", "\[Xi]zcoeff",
       ",", "\[Delta]\[CapitalUpsilon]z", ",", "\[CapitalUpsilon]gsph", ",", 
      "\[CapitalUpsilon]rg", ",", "\[CapitalUpsilon]zg", ",", 
      "\[CapitalUpsilon]\[Phi]g", ",", "\[CapitalUpsilon]tg", ",", 
      "dtgd\[Lambda]coeff", ",", "d\[Phi]gd\[Lambda]coeff", ",", 
      "dtspind\[Lambda]sparcoeff", ",", "d\[Phi]spind\[Lambda]sparcoeff", ",",
       "\[Delta]\[CapitalUpsilon]t", ",", "\[Delta]\[CapitalUpsilon]\[Phi]"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"orbitGeo", "=", 
      RowBox[{"KerrGeoOrbit", "[", 
       RowBox[{"aint", ",", "pint", ",", "eint", ",", "xint", ",", 
        RowBox[{"\"\<Parametrization\>\"", "->", "\"\<Phases\>\""}], ",", 
        RowBox[{"\"\<Method\>\"", "->", "\"\<Analytic\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"constmot", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Egsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Jzgsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Jzgsphx0", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Kgsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}]}], "}"}]}], ";", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Calculation", " ", "constants", " ", "of", " ", 
       RowBox[{"motion", ".", " ", "Jzgsphx0"}], " ", "serves", " ", "for", " ",
        "regularize", " ", "polar", " ", 
       RowBox[{"orbits", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]constmot", "=", 
      RowBox[{"\[Delta]constmotionsph", "[", 
       RowBox[{"aint", ",", " ", "pint", ",", " ", "xint", ",", "constmot"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Calculation", " ", "shifts", " ", "to", " ", "the", " ", "constants", " ",
        "of", " ", "motion"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Xi]zcoeff", "=", 
      RowBox[{"\[Xi]zsparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Near", " ", "identify", " ", "shif", " ", 
       RowBox[{"functions", ".", " ", "It"}], " ", "is", " ", "need", " ", 
       "for", " ", "the", " ", "shift", " ", "to", " ", "the", " ", "theta", " ", 
       RowBox[{"trajactory", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[CapitalUpsilon]z", "=", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"\[Delta]\[CapitalUpsilon]zsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint", ",", "constmot"}], "]"}], "-", 
        RowBox[{"devsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint", ",", "constmot"}], "]"}]}],
        "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spin", " ", "correction", " ", "to", " ", "the", " ", "theta", " ", 
       "frequency", " ", "in", " ", "the", " ", "fixed", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "average"}], ")"}], " ", "\"\<gauge\>\""}], "*)"}],
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalUpsilon]gsph", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"orbitGeo", "[", "\"\<Frequencies\>\"", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[CapitalUpsilon]rg", ",", "\[CapitalUpsilon]zg", ",", 
        "\[CapitalUpsilon]\[Phi]g", ",", "\[CapitalUpsilon]tg"}], "}"}], "=", 
