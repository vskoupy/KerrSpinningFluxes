Cell[BoxData[
 RowBox[{
  RowBox[{"pexShift", "[", "orbit_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "p", ",", "e", ",", "x", ",", "Eng", ",", "Lzg", ",", "Kg", ",",
       "r1", ",", "r2", ",", "r3", ",", "r4", ",", "z1", ",", "z2", ",", "kz",
       ",", "kr", ",", "az1Int\[CapitalSigma]", ",", "int\[CapitalSigma]r1", ",",
       "int\[CapitalSigma]r2", ",", "\[Delta]r1", ",", "\[Delta]r2", ",", 
      "\[Delta]z1", ",", "\[Delta]p", ",", "\[Delta]e", ",", "\[Delta]x"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"orbit", "[", "\"\<a\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"p", "=", 
      RowBox[{"orbit", "[", "\"\<p\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"e", "=", 
      RowBox[{"orbit", "[", "\"\<e\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"x", "=", 
      RowBox[{"orbit", "[", "\"\<Inclination\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Eng", "=", 
      RowBox[{"orbit", "[", "\"\<Energy\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Lzg", "=", 
      RowBox[{"orbit", "[", "\"\<AngularMomentum\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Kg", "=", 
      RowBox[{
       RowBox[{"orbit", "[", "\"\<CarterConstant\>\"", "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "*", "Eng"}], "-", "Lzg"}], ")"}], "^", "2"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "r2", ",", "r3", ",", "r4"}], "}"}], "=", 
      RowBox[{"orbit", "[", "\"\<RadialRoots\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z1", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z2", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "^", "2"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Eng", "^", "2"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"Lzg", "^", "2"}], "/", 
         RowBox[{"x", "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kz", "=", 
      RowBox[{
       RowBox[{"a", "^", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Eng", "^", "2"}]}], ")"}], "*", 
       RowBox[{
        RowBox[{"z1", "^", "2"}], "/", 
        RowBox[{"z2", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r1", "-", "r2"}], ")"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r3", "-", "r4"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r1", "-", "r3"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"r2", "-", "r4"}], ")"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"int\[CapitalSigma]r1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"EllipticPi", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"a", "^", "2"}]}], "*", 
           RowBox[{
            RowBox[{"z1", "^", "2"}], "/", 
            RowBox[{"r1", "^", "2"}]}]}], ",", "kz"}], "]"}], "/", 
        RowBox[{"EllipticK", "[", "kz", "]"}]}], "/", 
       RowBox[{"r1", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"int\[CapitalSigma]r2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"EllipticPi", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"a", "^", "2"}]}], "*", 
           RowBox[{
            RowBox[{"z1", "^", "2"}], "/", 
            RowBox[{"r2", "^", "2"}]}]}], ",", "kz"}], "]"}], "/", 
        RowBox[{"EllipticK", "[", "kz", "]"}]}], "/", 
       RowBox[{"r2", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"az1Int\[CapitalSigma]", "=", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"a", "*", "z1"}], 
         RowBox[{
          SuperscriptBox["r3", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["z1", "2"]}]}]], "+", 
        RowBox[{"2", "*", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[ImaginaryI]", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "r2"}], "+", "r3"}], ")"}]}], 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"r2", "+", 
                 RowBox[{"\[ImaginaryI]", " ", "a", " ", "z1"}]}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"r3", "+", 
                 RowBox[{"\[ImaginaryI]", " ", "a", " ", "z1"}]}], ")"}]}]], 
             ")"}], "*", 
            RowBox[{"EllipticPi", "[", 
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r1", "-", "r2"}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{"r3", "+", 
                  RowBox[{"\[ImaginaryI]", " ", "a", " ", "z1"}]}], ")"}]}], 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r1", "-", "r3"}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{"r2", "+", 
                  RowBox[{"\[ImaginaryI]", " ", "a", " ", "z1"}]}], ")"}]}]], 
              ",", "kr"}], "]"}]}], "]"}], "/", 
          RowBox[{"EllipticK", "[", "kr", "]"}]}]}]}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Delta]r1", "=", 
      RowBox[{
       RowBox[{"-", "r1"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r1", "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], ")"}], "*", "Eng"}], "-", 
         RowBox[{"a", "*", "Lzg"}]}], ")"}], "*", 
       RowBox[{"int\[CapitalSigma]r1", "/", 
        RowBox[{"Sqrt", "[", "Kg", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Delta]r2", "=", 
      RowBox[{
       RowBox[{"-", "r2"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r2", "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], ")"}], "*", "Eng"}], "-", 
         RowBox[{"a", "*", "Lzg"}]}], ")"}], "*", 
       RowBox[{"int\[CapitalSigma]r2", "/", 
        RowBox[{"Sqrt", "[", "Kg", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Delta]z1", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"Lzg", "-", 
          RowBox[{"a", "*", "Eng", "*", 
           RowBox[{"x", "^", "2"}]}]}], ")"}]}], "*", 
       RowBox[{"az1Int\[CapitalSigma]", "/", 
        RowBox[{"Sqrt", "[", "Kg", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Delta]p", "=", 
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["r2", "2"], "*", "\[Delta]r1"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r1", "+", "r2"}], ")"}], "2"]], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["r1", "2"], "*", "\[Delta]r2"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r1", "+", "r2"}], ")"}], "2"]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Delta]e", "=", 
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", "r2", "*", "\[Delta]r1"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r1", "+", "r2"}], ")"}], "2"]], "-", 
       FractionBox[
        RowBox[{"2", " ", "r1", "*", "\[Delta]r2"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r1", "+", "r2"}], ")"}], "2"]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Delta]x", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"z1", "*", "\[Delta]z1"}], "x"]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<\[Delta]p\>\"", "->", "\[Delta]p"}], ",", 
       RowBox[{"\"\<\[Delta]e\>\"", "->", "\[Delta]e"}], ",", 
       RowBox[{"\"\<\[Delta]x\>\"", "->", "\[Delta]x"}], ",", 
       RowBox[{"\"\<\[Delta]r1\>\"", "->", "\[Delta]r1"}], ",", 
       RowBox[{"\"\<\[Delta]r2\>\"", "->", "\[Delta]r2"}], ",", 
       RowBox[{"\"\<\[Delta]z1\>\"", "->", "\[Delta]z1"}]}], "|>"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.950773367010435*^9, 3.950773380852481*^9}, {
  3.950773432159745*^9, 3.950773689989737*^9}, {3.9507737248624163`*^9, 
  3.950773824316679*^9}, {3.95077414312234*^9, 3.950774153544366*^9}, {
  3.950775402762438*^9, 3.9507754238748627`*^9}, {3.9507799017291937`*^9, 
  3.950779983518633*^9}, {3.953008898295033*^9, 3.953008917258459*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"63847849-cf98-4c37-9ed4-b185acdfb27e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"KerrSpinOrbitCorrectionSphericalHJ", "[", 
   RowBox[{"aint_", ",", "pint_", ",", 
    RowBox[{"eint_", "?", "PossibleZeroQ"}], ",", "xint_", ",", "kmax_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "orbitGeo", ",", "constmot", ",", "\[Delta]constmot", ",", "\[Xi]zcoeff",
       ",", "\[Delta]\[CapitalUpsilon]z", ",", "\[CapitalUpsilon]gsph", ",", 
      "\[CapitalUpsilon]rg", ",", "\[CapitalUpsilon]zg", ",", 
      "\[CapitalUpsilon]\[Phi]g", ",", "\[CapitalUpsilon]tg", ",", 
      "dtgd\[Lambda]coeff", ",", "d\[Phi]gd\[Lambda]coeff", ",", 
      "dtspind\[Lambda]sparcoeff", ",", "d\[Phi]spind\[Lambda]sparcoeff", ",",
       "\[Delta]\[CapitalUpsilon]t", ",", "\[Delta]\[CapitalUpsilon]\[Phi]"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"orbitGeo", "=", 
      RowBox[{"KerrGeoOrbit", "[", 
       RowBox[{"aint", ",", "pint", ",", "eint", ",", "xint", ",", 
        RowBox[{"\"\<Parametrization\>\"", "->", "\"\<Phases\>\""}], ",", 
        RowBox[{"\"\<Method\>\"", "->", "\"\<Analytic\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"constmot", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Egsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Jzgsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Jzgsphx0", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}], ",", 
        RowBox[{"Kgsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint"}], "]"}]}], "}"}]}], ";", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Calculation", " ", "constants", " ", "of", " ", 
       RowBox[{"motion", ".", " ", "Jzgsphx0"}], " ", "serves", " ", "for", " ",
        "regularize", " ", "polar", " ", 
       RowBox[{"orbits", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]constmot", "=", 
      RowBox[{"\[Delta]constmotionsph", "[", 
       RowBox[{"aint", ",", " ", "pint", ",", " ", "xint", ",", "constmot"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Calculation", " ", "shifts", " ", "to", " ", "the", " ", "constants", " ",
        "of", " ", "motion"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Xi]zcoeff", "=", 
      RowBox[{"\[Xi]zsparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Near", " ", "identify", " ", "shif", " ", 
       RowBox[{"functions", ".", " ", "It"}], " ", "is", " ", "need", " ", 
       "for", " ", "the", " ", "shift", " ", "to", " ", "the", " ", "theta", " ", 
       RowBox[{"trajactory", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[CapitalUpsilon]z", "=", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"\[Delta]\[CapitalUpsilon]zsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint", ",", "constmot"}], "]"}], "-", 
        RowBox[{"devsph", "[", 
         RowBox[{"aint", ",", "pint", ",", "xint", ",", "constmot"}], "]"}]}],
        "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spin", " ", "correction", " ", "to", " ", "the", " ", "theta", " ", 
       "frequency", " ", "in", " ", "the", " ", "fixed", " ", 
       RowBox[{"(", 
        RowBox[{"on", " ", "average"}], ")"}], " ", "\"\<gauge\>\""}], "*)"}],
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalUpsilon]gsph", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"orbitGeo", "[", "\"\<Frequencies\>\"", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[CapitalUpsilon]rg", ",", "\[CapitalUpsilon]zg", ",", 
        "\[CapitalUpsilon]\[Phi]g", ",", "\[CapitalUpsilon]tg"}], "}"}], "=", 
      "\[CapitalUpsilon]gsph"}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{"Geodesic", " ", "theta", " ", "frequency"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dtgd\[Lambda]coeff", "=", 
      RowBox[{"dtgd\[Lambda]coeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "geodesic", " ", 
       "coordinate", " ", "time", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"dtspind\[Lambda]sparcoeff", "=", 
      RowBox[{"dtspind\[Lambda]sparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot", ",", 
        "\[Delta]constmot", ",", "\[Xi]zcoeff"}], "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "spin", " ", 
       "correction", " ", "to", " ", "the", " ", "coordinate", " ", "time", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]gd\[Lambda]coeff", "=", 
      RowBox[{"d\[Phi]gd\[Lambda]coeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot"}], 
       "]"}]}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "geodesic", " ", 
       "azimuthal", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]spind\[Lambda]sparcoeff", "=", 
      RowBox[{"d\[Phi]spind\[Lambda]sparcoeffsph", "[", 
       RowBox[{
       "kmax", ",", "aint", ",", "pint", ",", "xint", ",", "constmot", ",", 
        "\[Delta]constmot", ",", "\[Xi]zcoeff"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Fourier", " ", "coefficients", " ", "of", " ", "spin", " ", 
       "correction", " ", "to", " ", "the", " ", "azimthual", " ", 
       RowBox[{"velocity", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Delta]\[CapitalUpsilon]t", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"dtspind\[Lambda]sparcoeff", "[", 
        RowBox[{"[", 
         RowBox[{"kmax", "+", "1"}], "]"}], "]"}], "]"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spin", " ", "correction", " ", "to", " ", "the", " ", "coordinate", " ",
