 CellLabel->"In[56]:=",ExpressionUUID->"44c52624-4d09-44f3-ab04-1b4d3230de45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plotC1", "=", 
  RowBox[{"ListLogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Table", "[", 
