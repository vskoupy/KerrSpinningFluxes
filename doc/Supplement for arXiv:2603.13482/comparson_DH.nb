 CellChangeTimes->{{3.982307798545313*^9, 
  3.982307847928486*^9}},ExpressionUUID->"f2c673b5-f243-428d-a5a5-\
6533853fd443"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"modesk", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "ik"}], "]"}], "]"}], "[", "\"\<k\>\"", "]"}], ",", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"modesk", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "ik"}], "]"}], "]"}], 
                "[", "\"\<Amplitudes\>\"", "]"}], 
               "[", "\"\<\[ScriptCapitalI]\>\"", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], ".", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "/", "12"}], ",", 
              RowBox[{
               RowBox[{"-", "2"}], "/", "3"}], ",", 
              RowBox[{"2", "/", "3"}], ",", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "12"}]}], "}"}]}], "/", "0.05"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ik", ",", "1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"modesk", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"modesk2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "ik"}], "]"}], "]"}], "[", "\"\<k\>\"", "]"}], ",", 
